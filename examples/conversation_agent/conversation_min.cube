# examples/conversation_min.cube
# cubelang v0.1.0
#
# The working, executable sibling of conversation_agent.cube in this same
# directory. conversation_agent.cube demonstrates the intended shape of a
# full conversational ISolverLearn program (structs, maps, match-dispatch,
# retrieval); it does not currently compile+run cleanly under this VM (see
# docs/DRIFT.md, "Bugs found" #2 and #3) and this file is the only one
# actually exercised by the repo's own harness
# (examples/run_conversation_min.rs, `cargo run --example run_conversation_min`).
#
# Demonstrates: ISolver, storage+constructor, the minimal safe-subset shape
# a conversational program can take today.
# Run:    $CUBELANG_EXE run examples/conversation_agent/conversation_min.cube --json
# Expect: {"result":10,...}

program ConversationMin implements ISolver {
    type Input = str;
    type Output = number;

    storage {
        last_intent: mutable str = "";
        last_reply_kind: mutable str = "";
        success_count: mutable u64 = 0;
    }

    @system @once
    public function constructor() {
        assign last_intent = "boot";
        assign last_reply_kind = "idle";
        assign success_count = 0;
    }

    function parse(raw: str): Input {
        return raw;
    }

    function solve(input: Input): Output {
        create score : number;
        assign score = 0;

        create mode : symbol;
        assign mode = 1;
        store mode, "parsed_input";
        query mode;
        remember mode;

        add score, 10;
        store score, "base_score";

        assign last_intent = "generic";
        assign last_reply_kind = "answer";

        query score;
        remember score;
        sum score;

        add success_count, 1;
        return score;
    }

    pure function verify(input: Input, output: Output): bool {
        return true;
    }
}
