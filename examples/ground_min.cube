# ground_min.cube - the three-valued grounding contract, end to end.
#
#   QUERY -> len -> branch:
#       0 chunks -> gap    (say you don't know)
#       1 chunk  -> fact   (render it)
#       N chunks -> ASK    (only the caller knows which)
#
# Every opcode here executes. QUERY does an exact hash lookup with provenance;
# ASK suspends and resumes. Zero embeddings, zero forward passes.
#
# Demonstrates: ISolve, real QUERY (see docs/REFERENCE.md 3.4 -- QUERY is NOT
# trace-only despite docs/ASK_SUSPEND.md's own stale table), LEN/INDEX, ASK.
# Run:    $CUBELANG_EXE run examples/ground_min.cube --json --knowledge examples/facts_min.jsonl --arg "printing press"
# Expect: with no --knowledge file: {"result":0,...}  (QUERY finds nothing -> gap)
#         with --knowledge examples/facts_min.jsonl and mention "mercury"
#         (2 facts on that key): the program ASKs and suspends instead.

program Ground implements ISolve {

    storage {
        grounded: mutable u64 = 0;
        abstained: mutable u64 = 0;
    }

    @system @once
    public function constructor() {
        assign grounded = 0;
        assign abstained = 0;
    }

    @external
    public function solve(mention: str): number {
        query mention;

        # `ctx` is the SPEC's own name for this.
        create ctx : number;
        # use `pop` to get the ctx variable properly
        pop ctx;

        let n = ctx.len();

        create outcome : number;
        assign outcome = 0;

        if (n == 0) {
            # The gap. Nothing failed; we simply have no fact.
            add abstained, 1;
            assign outcome = 0;
        } else {
            if (n == 1) {
                add grounded, 1;
                assign outcome = 1;
            } else {
                # Ambiguity. The store holds several real, cited facts and
                # cannot choose. Only the caller knows which was meant.
                ask "which one did you mean", ctx;
                assign outcome = 2;
            }
        }

        return outcome;
    }
}
